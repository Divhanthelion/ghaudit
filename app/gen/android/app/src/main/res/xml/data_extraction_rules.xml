<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The GitHub token is encrypted with a Keystore key that never
     leaves this device, so neither a cloud backup nor a transfer to a new phone could
     read it: leave it out of both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
